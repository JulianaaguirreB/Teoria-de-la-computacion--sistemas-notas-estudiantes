<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    
    <!-- Propiedades -->
    <property name="LOG_PATH" value="logs" />
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n" />
    <property name="SECURITY_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} | %msg%n" />
    
    <!-- Consola -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>
    
    <!-- Archivo general de la aplicación -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/aplicacion.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/aplicacion-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>
    
    <!-- ARCHIVO ESPECÍFICO PARA VIOLACIONES DE SEGURIDAD -->
    <appender name="SECURITY_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/violaciones-seguridad.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/violaciones-seguridad-%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>90</maxHistory> <!-- Guardar 90 días -->
        </rollingPolicy>
        <encoder>
            <!-- Formato específico y más legible para seguridad -->
            <pattern>${SECURITY_PATTERN}</pattern>
        </encoder>
    </appender>
    
    <!-- Logger específico para violaciones de seguridad -->
    <logger name="SECURITY_VIOLATIONS" level="WARN" additivity="false">
        <appender-ref ref="SECURITY_FILE"/>
        <appender-ref ref="CONSOLE"/> <!-- Opcional: también ver en consola -->
    </logger>
    
    <!-- Logger raíz -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
    </root>
    
</configuration>